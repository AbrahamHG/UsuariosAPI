--TABLA

CREATE TABLE PLAYER
(
    PLAYER_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    NAME VARCHAR2(100) NOT NULL,
    AGE NUMBER(3) NOT NULL,
    TEAM VARCHAR2(100) NOT NULL,
    CREATED_DATE DATE DEFAULT SYSDATE,
    UPDATED_DATE DATE
);


